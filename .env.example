# NOTE: These values are now managed in the control panel (utilities/config.json),
# which is opened automatically on first run or with /setup. This file is kept as
# a fallback and for environments that need real environment variables. Values here
# are migrated into config.json automatically if config.json has no secrets yet.
#
# ── LLM / Model ──────────────────────────────────────────────────
ollama-api-key=
# ^ Your Ollama cloud API key from https://ollama.com

preconscious-key=
# ^ Separate API key for heartbeat/scheduled tasks

# ── Discord ──────────────────────────────────────────────────────
discord-token=
# ^ Discord bot token from https://discord.com/developers/applications

# ── Notion ───────────────────────────────────────────────────────
notion-key=
# ^ Notion internal integration token from https://www.notion.so/my-integrations

notion-default-page-id=
# ^ ID of the default parent page for new Notion pages

# ── Tavily (web search) ──────────────────────────────────────────
tavily-api-key=
# ^ Tavily search API key from https://app.tavily.com

# ── Obsidian (optional) ──────────────────────────────────────────
obsidian-host=http://127.0.0.1:27123
obsidian-api-key=
# ^ Obsidian Local REST API credentials

# ── Git / GitHub ─────────────────────────────────────────────────
github-token=
# ^ GitHub personal access token (used for creating PRs)

# ── Groq TTS (voice mode) ────────────────────────────────────────
groq-api-key=
# ^ Groq API key from https://console.groq.com/keys
